# ==============================================================================
# 1. SUPABASE & SINGLE-USER SECURITY LOCK
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your_supabase_publishable_or_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ALLOWED_USER_EMAIL=seshank@seshankailabs.com

# ==============================================================================
# 2. SYSTEM 1 — DECISION ENGINE (MESH API -> JEV)
# ==============================================================================
MESH_API_KEY=your_mesh_api_key
MESH_API_BASE_URL=https://api.meshapi.ai/v1
JEV_MODEL_ID=typesafe/jev-1.13

# ==============================================================================
# 3. SYSTEM 2 — GENERATION & VISUAL ENGINE (GOOGLE GEMINI API)
# ==============================================================================
GEMINI_API_KEY=your_gemini_api_key
GEMINI_FLASH_MODEL=gemini-2.5-flash
GEMINI_PRO_MODEL=gemini-2.5-pro
GEMINI_IMAGE_MODEL=gemini-nano-banana-2.1
GEMINI_IMAGE_STUDIO_MODEL=gemini-3-pro-image

# ==============================================================================
# 4. VOICE-TO-TEXT ENGINE (GROQ FREE TIER)
# ==============================================================================
GROQ_API_KEY=your_groq_api_key
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# ==============================================================================
# 5. FREE-TIER ENRICHMENT & VERIFIED RESEARCH WATERFALL
# ==============================================================================
APOLLO_API_KEY=your_apollo_api_key
TAVILY_API_KEY=your_tavily_api_key
SERPER_API_KEY=your_serper_api_key
SERPAPI_KEY=your_serpapi_key

# ==============================================================================
# 6. HOSTINGER EMAIL ENGINE (SMTP SENDING + IMAP AUTO-REPLY/BOUNCE SYNC)
# ==============================================================================
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=seshank@seshankailabs.com
SMTP_PASS=your_hostinger_email_password
IMAP_HOST=imap.hostinger.com
IMAP_PORT=993

# ==============================================================================
# 7. VERCEL CRON & DAILY SAFETY CAPS
# ==============================================================================
CRON_SECRET=your_random_cron_secret_hex
DAILY_EMAIL_CAP=10
DAILY_LINKEDIN_CAP=20
DRY_RUN_EMAILS=true
